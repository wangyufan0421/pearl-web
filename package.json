{
  "name": "pearl-chinese-community",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && node scripts/run-services.mjs --dev",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.runtime.json",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && npm run build:server && vite build",
    "start": "node scripts/run-services.mjs",
    "start:web": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/main.js",
    "collect": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/market/worker.js",
    "translate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/translation/worker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "latest",
    "pdfjs-dist": "^6.4.299",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
