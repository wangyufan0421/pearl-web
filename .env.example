# All variables below are server-only. Never expose them through VITE_ variables.
TWITTER241_API_KEY=your_twitter241_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
COMMUNITY_ADMIN_TOKEN=your_community_admin_token
# Ordinary cloud server: bind to loopback behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=3000
# Market collection also works without any Supabase configuration.
# Use file for local/server disk, or supabase after applying the snapshot migration.
MARKET_STORAGE=file
MARKET_DATA_DIR=.data/market
# Optional background Chinese translation of archived community sources.
COMMUNITY_TRANSLATION_BASE_URL=https://api.erisedai.com/v1
COMMUNITY_TRANSLATION_API_KEY=your_translation_api_key
COMMUNITY_TRANSLATION_MODEL=gpt-6-luna
