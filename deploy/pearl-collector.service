[Unit]
Description=Pearl independent market data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pearl
WorkingDirectory=/opt/pearl
EnvironmentFile=/etc/pearl/pearl.env
ExecStart=/usr/bin/node /opt/pearl/dist-server/market/worker.js
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
